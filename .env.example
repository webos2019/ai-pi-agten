# LLM API 配置 (兼容 OpenAI 接口)
# 默认使用 DeepSeek，可在前端设置面板切换以下任意提供商：
#   豆包(Doubao):     https://ark.cn-beijing.volces.com/api/v3  模型: doubao-pro-32k
#   OpenAI:           https://api.openai.com/v1                  模型: gpt-4o-mini / gpt-4o
#   Moonshot(Kimi):   https://api.moonshot.cn/v1                 模型: moonshot-v1-8k / 32k
#   智谱 GLM:         https://open.bigmodel.cn/api/paas/v4       模型: glm-4-flash / glm-4-air
#   通义千问:          https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-turbo / plus / max
#   百川 Baichuan:    https://api.baichuan-ai.com/v1             模型: Baichuan4
#   MiniMax:          https://api.minimax.chat/v1                模型: abab6.5s-chat
#   零一万物 Yi:      https://api.lingyiwanwu.com/v1             模型: yi-large
#   阶跃星辰 Step:    https://api.stepfun.com/v1                 模型: step-1-8k
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding API 配置 (长期记忆向量化)
# 本地模式 (推荐): 无需 API Key，CPU 运行，永久免费
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
#
# API 模式 (切换 EMBEDDING_MODE=api 时启用):
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1024
#
# 注意: DeepSeek 不提供 embedding 接口
# 本地模式安装: pip install sentence-transformers
# 首次运行会自动下载模型 (~100MB)

# 持久化配置 (留空则不启用持久化，纯内存模式)
# SQLite + WAL 模式: 并发读不阻塞写，无文件锁冲突
# 启用后：会话历史 + 用户记忆服务重启后自动恢复
DB_PATH=data/pi_agent.db
# DUCKDB_PATH=...  # 向后兼容 (自动映射为 .db 后缀)

# GitHub Token (可选，提升 API 速率限制从 60→5000 次/小时)
# 不配置也可使用 github_repo 工具访问公开仓库
# GITHUB_TOKEN=ghp_your_github_token_here

# ── 搜索引擎配置 (可选) ──
# web_search 工具支持多搜索引擎，默认 auto 模式自动选择最佳引擎
# 不配置任何 Key 时自动使用 Bing（免费，国内可直连）
#
# Tavily (推荐) — 专为 AI Agent 设计的搜索 API
# 返回网页正文摘要 + AI 生成答案，搜索质量最好
# 获取 Key: https://tavily.com (免费额度 1000 次/月)
# TAVILY_API_KEY=tvly-your_tavily_api_key_here
#
# Serper — Google 搜索 API 代理
# 返回 Google 搜索结果，速度快，质量高
# 获取 Key: https://serper.dev (免费额度 2500 次)
# SERPER_API_KEY=your_serper_api_key_here
#
# Google Custom Search API (备选)
# GOOGLE_CSE_API_KEY=your_google_api_key
# GOOGLE_CSE_ID=your_cse_id

# 商汤 SenseTime 文字生图 API 配置
# 获取方式: https://console.sensenova.cn/
SENSETIME_API_KEY=your_sensetime_api_key_here
SENSETIME_API_URL=https://api.sensenova.cn/compatible-mode/v1/images/generations
SENSETIME_IMAGE_MODEL=SenseMirage-Text-Image-Expert

# Agnes AI 免费生图 API 配置
# 获取方式: https://platform.agnes-ai.com (免费额度)
# 模型: agnes-image-2.1-flash (免费) / agnes-image-2.0-flash
AGNES_API_KEY=your_agnes_api_key_here
AGNES_API_URL=https://apihub.agnes-ai.com/v1/images/generations
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
